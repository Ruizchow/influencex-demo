# Copy to .env and fill your own values, or run npm run setup:local.
# Never commit .env. Leave optional API keys empty until needed.
NODE_ENV=development
PORT=8080
BASE_PATH=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Required in production. Generate: openssl rand -base64 32
MAILBOX_ENCRYPTION_KEY=

# Optional PostgreSQL; omit to use SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# SQLITE_DB_PATH=/absolute/path/to/influencex.db

# Choose an AI provider for real AI execution.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Discovery
YOUTUBE_API_KEY=
APIFY_TOKEN=
HUNTER_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Optional Gmail OAuth
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# See server/publish/oauth.js for provider-specific OAuth configuration.
# CORS_ORIGINS=https://your-domain.example
# REDIS_URL=redis://localhost:6379
# SCHEDULER_ENABLED=false
